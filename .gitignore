# Publish only this allowlist. Private production files stay outside the repo.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/NOTICE.md
!/install.cmd
!/install.ps1
!/install.sh
!/preview.html
!/checksums.sha256
!/pet/
!/assets/
!/tests/

# Defense in depth: never commit private inputs, credentials, or machine state.
**/.env
**/.env.*
**/*token*
**/*secret*
**/*credential*
**/*.pem
**/*.key
**/*.pfx
**/hosts.yml
**/*.webm
**/*.log
**/.DS_Store
**/Thumbs.db
**/__pycache__/
**/node_modules/
**/.codex/
**/.agents/
**/work/
**/private/
**/backups/
**/retained-variants/
**/*local*
